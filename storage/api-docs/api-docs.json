                                    "query",
                                    "type"
                                ],
                                "properties": {
                                    "query": {
                                        "type": "string",
                                        "format": "query",
                                        "example": "AAAAWQOPBUPWEV-UHFFFAOYSA-N"
                                    },
                                    "type": {
                                        "type": "string",
                                        "format": "type",
                                        "example": "InChiKey"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
